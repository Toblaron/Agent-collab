# Your API keys. Make your own copy with:   cp keys.env.example keys.env
# then open keys.env (nano keys.env), paste each key right after its = sign, and save.
# Fill in as many or as few as you like. keys.env stays on your device; git ignores it.

# Gemini (Google): free tier. Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Groq: free tier, very fast. https://console.groq.com/keys
GROQ_API_KEY=

# OpenRouter: models ending in ":free" cost nothing. https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Mistral: free "Experiment" plan. https://console.mistral.ai/api-keys
MISTRAL_API_KEY=

# Hugging Face: free monthly credits. https://huggingface.co/settings/tokens
HF_TOKEN=

# Claude (Anthropic): paid. Also needs:  pip install -e .[claude]
ANTHROPIC_API_KEY=

# Optional: better web search than the keyless default. Free tier at https://app.tavily.com
TAVILY_API_KEY=
